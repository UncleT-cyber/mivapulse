{
  "rewrites": [
    { "source": "/api/v2/admin-auth/:path*", "destination": "/api/v2/admin-auth" },
    { "source": "/api/v2/contributions/:path*", "destination": "/api/v2/contributions" },
    { "source": "/api/v2/audit/:path*", "destination": "/api/v2/audit" },
    { "source": "/api/v2/audit", "destination": "/api/v2/audit" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "backend/**"
    }
  }
}